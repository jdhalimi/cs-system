# OAuth Google (meme fichier client pour Contacts, Drive et Forms)
GOOGLE_CLIENT_SECRETS=../cs-contacts/creds/credentials.json
GOOGLE_TOKEN_FILE=.state/google-token.json

# Notion (jeton secret ; les identifiants de base vont dans config.toml [notion])
NOTION_TOKEN=

# MyCitya (identifiants de connexion secrets)
CITYA_EMAIL=
CITYA_PASSWORD=

# Les identifiants et URL non secrets (dossier Drive, bases Notion, immeuble
# et URL Documents Citya) se configurent dans config.toml, pas ici.
